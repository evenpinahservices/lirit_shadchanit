{
  "_documentation": "Exact allowed values for each field as defined in the code",
  
  "fullName": {
    "type": "string",
    "required": true,
    "minLength": 2,
    "restricted": false,
    "description": "OPEN TEXT - Any string with minimum 2 characters"
  },
  
  "email": {
    "type": "string",
    "required": false,
    "format": "email",
    "restricted": false,
    "description": "OPEN TEXT - Valid email format or empty string \"\"",
    "note": "Can be empty string if not provided"
  },
  
  "phone": {
    "type": "string",
    "required": false,
    "minLength": 9,
    "restricted": false,
    "description": "OPEN TEXT - Any string with minimum 9 characters or empty string \"\"",
    "note": "Can be empty string if not provided"
  },
  
  "dob": {
    "type": "string",
    "required": true,
    "restricted": false,
    "description": "OPEN TEXT - Date of birth",
    "formats": [
      "Gregorian: YYYY-MM-DD (e.g., '1995-05-15')",
      "Hebrew: 'Hebrew: Day Month Year' (e.g., 'Hebrew: א תשרי 5755')",
      "Year only: YYYY (e.g., '1995')"
    ]
  },
  
  "gender": {
    "type": "enum",
    "required": true,
    "restricted": true,
    "allowedValues": ["Male", "Female"]
  },
  
  "location": {
    "type": "string",
    "required": false,
    "minLength": 2,
    "restricted": false,
    "description": "OPEN TEXT - Any string with minimum 2 characters (optional field)"
  },
  
  "height": {
    "type": "number",
    "required": false,
    "restricted": false,
    "description": "Number in centimeters",
    "default": 0
  },
  
  "eyeColor": {
    "type": "string",
    "required": false,
    "restricted": true,
    "allowedValues": ["Brown", "Blue", "Green", "Hazel", "Grey", "Other"]
  },
  
  "hairColor": {
    "type": "string",
    "required": false,
    "restricted": true,
    "allowedValues": ["Black", "Brown", "Blonde", "Red", "Grey", "Bald", "White", "Other"]
  },
  
  "photoUrl": {
    "type": "string",
    "required": false,
    "restricted": false,
    "description": "OPEN TEXT - URL string or empty string"
  },
  
  "galleryImages": {
    "type": "array",
    "required": false,
    "restricted": false,
    "description": "Array of URL strings",
    "itemType": "string",
    "default": []
  },
  
  "ethnicity": {
    "type": "string",
    "required": false,
    "restricted": true,
    "allowedValues": ["Ashkenazi", "Sephardi", "Mizrahi", "Yemenite", "Ethiopian", "Convert", "Mixed", "Other"]
