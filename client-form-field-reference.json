  "fieldTypes": {
    "string": [
      "fullName",
      "email",
      "phone",
      "dob",
      "location",
      "ethnicity",
      "tribalStatus",
      "maritalStatus",
      "familyBackground",
      "education",
      "occupation",
      "learningStatus",
      "headCovering",
      "smoking",
      "personality",
      "medicalHistoryDetails",
      "willingToRelocate",
      "expectedHeadCovering",
      "references",
      "notes",
      "resumeRawText",
      "resumeRawTextTranslated",
      "photoUrl"
    ],
    "number": [
      "height",
      "children"
    ],
    "array": [
      "galleryImages",
      "languages",
      "religiousAffiliation",
      "hobbies",
      "ageGapPreference",
      "preferredEthnicities",
      "preferredHashkafos",
      "preferredLearningStatus",
      "preferredHeadCovering"
    ],
    "boolean": [
      "active",
      "medicalHistory"
    ],
    "enum": [
      "gender"
    ]
  },
  
  "formSteps": [
    {
      "step": 0,
      "title": "Basic Info",
      "fields": ["fullName", "email", "phone", "dob", "gender", "location"]
    },
    {
      "step": 1,
      "title": "Appearance",
      "fields": ["height", "eyeColor", "hairColor", "photoUrl", "galleryImages"]
    },
    {
      "step": 2,
      "title": "Background",
      "fields": ["ethnicity", "tribalStatus", "maritalStatus", "languages", "familyBackground", "education", "occupation"]
    },
    {
      "step": 3,
      "title": "Religious Details",
      "fields": ["religiousAffiliation", "learningStatus", "headCovering", "smoking"]
    },
    {
      "step": 4,
      "title": "Personal",
      "fields": ["hobbies", "personality", "medicalHistory", "medicalHistoryDetails"]
    },
    {
      "step": 5,
      "title": "Preferences",
      "fields": ["ageGapPreference", "willingToRelocate", "preferredEthnicities", "preferredHashkafos", "preferredLearningStatus", "expectedHeadCovering", "preferredHeadCovering"]
    },
    {
      "step": 6,
      "title": "Admin",
      "fields": ["references", "notes", "resumeRawText", "resumeRawTextTranslated"]
    }
  ],
  
  "dateFormats": {
    "dob": {
      "description": "Date of Birth supports three formats",
      "formats": [
        "Gregorian: YYYY-MM-DD (e.g., '1995-05-15')",
        "Hebrew: 'Hebrew: Day Month Year' (e.g., 'Hebrew: א תשרי 5755')",
        "Year Only: YYYY (e.g., '1995')"
      ]
    }
  },
  
  "validationRules": {
    "fullName": {
      "required": true,
      "minLength": 2,
      "message": "Name is required"
    },
    "email": {
      "required": false,
      "format": "email",
      "message": "Invalid email (or can be empty string)"
    },
    "phone": {
      "required": false,
      "minLength": 9,
      "message": "Invalid phone number (or can be empty string)"
    },
    "dob": {
      "required": true,
      "message": "Date of birth is required"
    },
    "gender": {
      "required": true,
      "options": ["Male", "Female"]
    },
    "location": {
      "required": false,
      "minLength": 2,
      "message": "Location is optional"
    }
  }
}


