{
  "_documentation": "Complete field reference for Add Client Form with all possible values",
  
  "fieldOptions": {
    "gender": {
      "type": "enum",
      "required": true,
      "options": ["Male", "Female"]
    },
    
    "eyeColor": {
      "type": "select",
      "required": false,
      "options": ["Brown", "Blue", "Green", "Hazel", "Grey", "Other"]
    },
    
    "hairColor": {
      "type": "select",
      "required": false,
      "options": ["Black", "Brown", "Blonde", "Red", "Grey", "Bald", "White", "Other"]
    },
    
    "ethnicity": {
      "type": "select",
      "required": false,
      "options": ["Ashkenazi", "Sephardi", "Mizrahi", "Yemenite", "Ethiopian", "Convert", "Mixed", "Other"]
    },
    
    "tribalStatus": {
      "type": "select",
      "required": false,
      "options": ["Cohen", "Levi", "Yisrael", "Bat Cohen", "Bat Levi", "Bat Yisrael", "Convert"]
    },
    
    "maritalStatus": {
      "type": "select",
      "required": false,
      "options": ["Single", "Divorced", "Divorced with Kids", "Widowed", "Widowed with Kids"]
    },
    
    "languages": {
      "type": "multiselect",
      "required": false,
      "options": ["English", "Hebrew", "French", "Spanish", "Yiddish", "Russian", "Portuguese", "German"]
    },
    
    "religiousAffiliation": {
      "type": "multiselect",
      "required": false,
      "options": [
        "Haredi",
        "Hardal",
        "Dati Leumi",
        "Modern Orthodox",
        "Yeshivish American",
        "Yeshivish Litvish",
        "Yeshivish Hasidish",
        "Chabad",
        "Masorti",
        "Traditional",
        "Secular"
      ]
    },
    
    "learningStatus": {
      "type": "select",
      "required": false,
      "options": ["Full Time", "Half Time", "Koveah Itim", "Working - Not Learning"]
    },
    
    "headCovering": {
      "type": "select",
      "required": false,
      "options": ["N/A", "None", "Wig", "Tichel", "Hat", "Scarf", "Flexible"]
    },
    
    "smoking": {
      "type": "select",
      "required": false,
      "options": ["No", "Yes", "Occasionally", "Vape"]
    },
    
    "hobbies": {
      "type": "multiselect",
      "required": false,
      "options": [
        "Reading",
        "Hiking",
        "Music",
        "Cooking",
        "Traveling",
        "Learning Torah",
        "Sports",
        "Art",
        "Writing",
        "Volunteering",
        "Photography",
        "Gardening",
        "Chess",
        "History",
        "Swimming",
        "Running"
      ]
    },
    
    "medicalHistory": {
      "type": "radio",
      "required": false,
      "options": ["No", "Yes"]
    },
    
    "ageGapPreference": {
      "type": "multiselect",
      "required": false,
      "options": ["I don't mind", "1-2 years", "3-5 years", "5-10 years", "Any"]
    },
    
    "willingToRelocate": {
      "type": "select",
      "required": false,
      "options": ["Yes", "No", "Maybe"]
    },
    
    "preferredEthnicities": {
      "type": "multiselect",
      "required": false,
      "options": [
        "I don't mind",
        "Ashkenazi",
        "Sephardi",
        "Mizrahi",
        "Yemenite",
        "Ethiopian",
        "Convert",
        "Mixed",
        "Other"
      ]
    },
    
    "preferredHashkafos": {
      "type": "multiselect",
      "required": false,
      "options": [
        "I don't mind",
        "Haredi",
        "Hardal",
        "Dati Leumi",
        "Modern Orthodox",
        "Yeshivish American",
        "Yeshivish Litvish",
        "Yeshivish Hasidish",
        "Chabad",
        "Masorti",
        "Traditional",
        "Secular"
      ]
    },
    
    "preferredLearningStatus": {
      "type": "multiselect",
      "required": false,
      "options": [
        "I don't mind",
        "Full Time",
        "Half Time",
        "Koveah Itim",
        "Working - Not Learning"
      ]
    },
    
    "preferredHeadCovering": {
      "type": "multiselect",
      "required": false,
      "options": [
        "I don't mind",
        "N/A",
        "None",
        "Wig",
        "Tichel",
        "Hat",
        "Scarf",
        "Flexible"
